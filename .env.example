# ============================================
# MISTRAL (Remon Defense Agent) - Environment Config
# ============================================
# ВАЖНО: Скопируйте этот файл в .env и заполните реальными данными
# НЕ КОМИТЬТЕ .env в git! Он уже в .gitignore

# ============================================
# OpenRouter API Configuration
# ============================================
# Получите ключ на https://openrouter.ai/
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Модели по умолчанию (активные через рубильник)
# Доступные модели:
# - openai/gpt-5.1-codex (дефолт, активная)
# - openai/gpt-5.2-codex (стратегический анализ)
# - qwen/qwen-3-coder-next (быстрые правила)
DEFAULT_MODEL=openai/gpt-5.1-codex
ALTERNATIVE_MODEL_1=openai/gpt-5.2-codex
ALTERNATIVE_MODEL_2=qwen/qwen-3-coder-next

# ============================================
# Telegram Bot Configuration
# ============================================
# Получите токен у @BotFather в Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ID информационного безопасника (можно получить у @userinfobot)
SECURITY_ADMIN_ID=your_telegram_user_id_here

# ============================================
# Monitoring Thresholds
# ============================================
# Пороги для обнаружения аномалий (настраиваемые под инфраструктуру)

# Системные метрики
CPU_THRESHOLD_PERCENT=80
RAM_THRESHOLD_PERCENT=85
LOAD_AVERAGE_THRESHOLD=4.0
DISK_IO_THRESHOLD=100

# Сетевой мониторинг
CONNECTION_THRESHOLD_PER_IP=100
SYN_FLOOD_THRESHOLD=500
DDOS_CONNECTION_THRESHOLD=1000

# Аутентификация
FAILED_LOGIN_THRESHOLD=5
FAILED_LOGIN_WINDOW_SECONDS=300

# ============================================
# Logging Configuration
# ============================================
# Путь к директории логов (на сервере: /var/log/mistral/)
LOG_DIR=/var/log/mistral
LOG_LEVEL=INFO

# ============================================
# Security Settings
# ============================================
# Путь к директории конфигурации (на сервере: /etc/mistral/)
CONFIG_DIR=/etc/mistral

# Путь к базе знаний write-ups
WRITEUPS_DIR=./data/writeups

# Путь к базе знаний методик
KNOWLEDGE_BASE_DIR=./data/knowledge_base

# ============================================
# Docker Integration
# ============================================
# Путь к Docker socket (для мониторинга контейнеров)
DOCKER_SOCKET=/var/run/docker.sock

# ============================================
# Scanner Configuration
# ============================================
# Путь к Semgrep и Trivy (устанавливаются отдельно)
SEMGREP_PATH=/usr/local/bin/semgrep
TRIVY_PATH=/usr/local/bin/trivy

# ============================================
# Emergency Controls
# ============================================
# Рубильник для отключения агента в экстренных случаях
# (по умолчанию: false)
AGENT_EMERGENCY_DISABLE=false

# ============================================
# Backup Configuration
# ============================================
# Путь к резервной копии конфигурации
BACKUP_CONFIG_PATH=/etc/mistral/config.backup.yaml
