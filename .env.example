# MISTRAL Defense — Server Environment Configuration
# Copy this file to .env and fill in your real values
# ═════════════════════════════════════════════════════════════════════════════

# ── AI Aggregator (aitunnel.ru) ──────────────────────────────────────────────
AITUNNEL_API_KEY=your_aitunnel_api_key_here
AITUNNEL_BASE_URL=https://api.aitunnel.ru/v1/

# ── WebSocket Secure (WSS) ───────────────────────────────────────────────────
WSS_PORT=8443
API_PORT=8080
WSS_CERT_PATH=./certs/cert.pem
WSS_KEY_PATH=./certs/key.pem
WSS_SECRET_TOKEN=generate_random_32char_string_here

# ── Telegram Bot ─────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Порт HTTP-сервера бота (для приёма уведомлений от server.js)
BOT_HTTP_PORT=8081

# ── Database ─────────────────────────────────────────────────────────────────
DB_PATH=./data/mistral.db

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_RETENTION_DAYS=30

# ── Monitors (used by Lua scripts) ───────────────────────────────────────────
MISTRAL_SERVER_URL=http://localhost:8080
MONITOR_INTERVAL=5
AUTH_CHECK_INTERVAL=10
NETWORK_CHECK_INTERVAL=8
INTEGRITY_CHECK_INTERVAL=30

# Thresholds
CPU_THRESHOLD=85
RAM_THRESHOLD=90
DISK_THRESHOLD=90
CONN_THRESHOLD=1000
MAX_FAILED_LOGINS=5

# Integrity watch paths (comma-separated)
WATCH_PATHS=/etc/nginx/nginx.conf,/root/.ssh/authorized_keys,/etc/hosts
DOCKER_COMPOSE_PATH=/opt/remon/docker-compose.yml
NGINX_CONF_PATH=/etc/nginx/nginx.conf

# ── SSH whitelist (comma-separated IPs) ────────────────────────────────────────
SSH_WHITELIST=

# ── Node environment ───────────────────────────────────────────────────────
NODE_ENV=production
